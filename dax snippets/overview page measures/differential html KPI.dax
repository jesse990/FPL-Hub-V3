Differential Pick KPI = 

VAR PlayerKey   = [mostpoints_low%]
VAR Points      = CALCULATE([total points], fact_table[playerkey] = PlayerKey)
VAR PlayerName  = CALCULATE(max(dim_players_season[web_name]), dim_players_season[playerkey] = PlayerKey)
VAR TeamKey     = CALCULATE(MAX(fact_table[teamkey]), fact_table[playerkey] = PlayerKey)
VAR PPG         = CALCULATE([PPG], dim_players_season[playerkey] = PlayerKey)
VAR Ownership   = CALCULATE([Ownership %], dim_players_season[playerkey] = PlayerKey)
VAR OwnGrowth   = CALCULATE([3 Week Ownership change], fact_table[playerkey] = PlayerKey)
VAR ImageURL    = CALCULATE(MAX(dim_players_season[photo]), dim_players_season[playerkey] = PlayerKey)
VAR TeamBadge   = CALCULATE(MAX(dim_teams[badge]), dim_teams[teamkey] = TeamKey)
VAR Position    = CALCULATE(max(dim_players_season[position_id]), dim_players_season[playerkey] = PlayerKey)
VAR PosAvg      = SWITCH(Position, 1,[gk_ppg],2,[def_ppg],3,[mid_ppg],4,[fwd_ppg])
VAR PPG_Diff    = PPG - PosAvg
VAR price       = CALCULATE([price], dim_players_season[playerkey] = PlayerKey)
VAR MinGW       = [min_gw]
VAR MaxGW       = [max_gw]
VAR GrowthArrow = IF(OwnGrowth = 0, "", IF(OwnGrowth > 0, "▲", "▼"))
VAR PPG_BM      = IF(PPG_Diff = 0, "", IF(PPG_Diff > 0, "▲", "▼")) 

RETURN
"<div style='
    width: 400px; 
    height: 165px;
    background: linear-gradient(135deg, #051624 0%, #0C2549 25%, #1A366F 45%, #252A5E 65%, #2E1B5E 80%, #1F0E45 100%);
    background-size: 200% 200%;
    animation: shine 12s linear infinite;
    border-radius: 18px;
    padding: 16px;
    position: relative;
    overflow: hidden;
    font-family: ""Segoe UI"", sans-serif;
    color: white;
'>

    <!-- Shine Overlay -->
    <div style='position:absolute; inset:0; background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, transparent 50%); pointer-events:none;'></div>

    <div style='position: relative; z-index: 2; display: flex; height: 100%;'>

        <!-- Left Content -->
        <div style='flex: 1; display: flex; flex-direction: column; justify-content: space-between; padding-right: 12px;'>
            
            <div>
                <p style='margin:0; font-size: 12.5px; font-weight: 600; letter-spacing: 0.8px; opacity: 0.95; text-transform: uppercase;'>
                Differential💎<5% • GW" & MinGW & "–" & MaxGW & "
                </p>
                 <h1 style='margin: 6px 0 4px 0; font-size: 23px; font-weight: 800; line-height: 1.05;'>" & PlayerName & " <span style='font-size: 12px; opacity: 0.7; font-weight: 500;'>(" & FORMAT(Price, "£0.0m") & ")</span></h1>
            </div>

            <div>
                <!-- Big Points -->
                <div style='font-size: 38px;color:#34D399; font-weight: 800; line-height: 1; margin-bottom: 8px;'>" & Points & "<span style='font-size: 12px; margin-left: 4px;'>points</span></div>
                
                <!-- Stats -->
                <div style='font-size: 12.2px; line-height: 1.55; color: #E6EEFF;'>
                    <div>
                        <span style='color: #FFFFFF ; font-weight: 400;'>" & FORMAT(PPG, "0.0") & " Points p90 </span> 
                        <span style='color: " & switch(TRUE(), PPG_Diff > 0, "#34D399", PPG_Diff<0, "#EF4444", PPG_Diff = 0 , "grey") & "; font-weight: 800;'>" & PPG_BM & "</span>
                        <span style='color: " & switch(TRUE(), PPG_Diff > 0, "#34D399", PPG_Diff<0, "#EF4444", PPG_Diff = 0 , "grey")  & "; font-weight: 800;'>" & FORMAT(PPG_Diff, "+0.0") & "</span>
                        <span style='color: #FFFFFF; font-weight: 400;'> vs Pos Avg</span>
                    </div>
                    <div style='margin-top: 4px;'>
                        <span style='color:  #FFFFFF; font-weight: 400;'>" & FORMAT(Ownership*100, "0") & "% Owned</span> 
                        <span style='color: " & switch(TRUE(), OwnGrowth > 0, "#34D399", OwnGrowth<0, "#EF4444", OwnGrowth = 0 , "grey")  & "; font-weight: 800;'> " & GrowthArrow & " " & FORMAT(OwnGrowth*100, "0.0") & "% </span>
                        <span style='color: #FFFFFF; font-weight: 400;'> Last 3 gws</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Player Visual -->
        <div style='width: 138px; display: flex; align-items: center; justify-content: center; position: relative;'>

            <!-- White Circle Background -->
            <div style='width: 125px; height: 125px; background: #FFFFFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0,0,0,0.35); position: relative;'>
                
                <img src='" & ImageURL & "' style='width: 112px; height: 112px; object-fit: contain; border-radius: 50%;' />

                <!-- Team Badge -->
                <div style='position: absolute; top: 4px; right: 4px; width: 38px; height: 38px; background: white; border-radius: 50%; padding: 3px; box-shadow: 0 4px 10px rgba(0,0,0,0.4);'>
                    <img src='" & TeamBadge & "' style='width: 100%; height: 100%; object-fit: contain;' />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes shine {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}
</style>"